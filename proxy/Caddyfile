# Caddy reverse proxy for the live-stream-radio web console, with automatic HTTPS.
# Caddy gets and renews the certificate from Let's Encrypt by itself.
#
# 1. Point a DNS record (e.g. radio.example.com) at this server, and open ports 80 and 443.
# 2. Replace radio.example.com below, and 8000 if you changed api.port.
# 3. In your project's config.json, keep "host": "localhost" and add "trust_proxy": true
#    to the "api" section, then restart live-stream-radio.
# 4. Install it (Ubuntu / Debian: https://caddyserver.com/docs/install), then:
#      sudo cp Caddyfile /etc/caddy/Caddyfile
#      sudo systemctl reload caddy
# 5. Open https://radio.example.com

radio.example.com {
	# The console lives at /console
	redir / /console

	# Caddy sets X-Forwarded-For to the real visitor address
	reverse_proxy localhost:8000

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
